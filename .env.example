# Atlas AI environment variables.
# Copy to .env (never commit .env) and fill in values.
# Variables marked "(not used yet)" are reserved for later phases so the
# full shape of the config is visible from the start.

# ---------- Application ----------
# Deployment environment name: local | test | staging | production
APP_ENV=local
# Python log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Host port the API is published on by docker compose
API_PORT=8000

# ---------- Postgres (Supabase image) ----------
# Superuser password for the local database container. Local only.
POSTGRES_PASSWORD=postgres
# Host port the database is published on (54322 avoids clashing with a local Postgres)
POSTGRES_PORT=54322
# Password for the restricted `atlas_api` login role the API and worker use for
# every request (RLS applies). Set by `python -m app.db.manage migrate`. Min 16 chars.
ATLAS_API_DB_PASSWORD=atlas_api_local_password
# Connection string for requests, as atlas_api, when run outside docker.
# Never point this at postgres/service_role: they bypass RLS.
# docker compose overrides this to point at the `db` service.
DATABASE_URL=postgresql://atlas_api:atlas_api_local_password@localhost:54322/postgres
# Password for the restricted `atlas_worker` role used by the ingestion worker.
# Its RLS policies only match rows of the tenant whose job it is running. Min 16 chars.
ATLAS_WORKER_DB_PASSWORD=atlas_worker_local_password
# Worker connection when run outside docker (compose overrides it).
WORKER_DATABASE_URL=postgresql://atlas_worker:atlas_worker_local_password@localhost:54322/postgres
# Schema owner connection, used only by migrations and the seed script.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
# Connection pool size per API/worker process
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# ---------- Qdrant ----------
# Host port Qdrant's HTTP API is published on
QDRANT_PORT=6333
# Qdrant base URL used outside docker (compose overrides it to http://qdrant:6333)
QDRANT_URL=http://localhost:6333
# API key for Qdrant Cloud; leave empty for the local container
QDRANT_API_KEY=
# Shared collection for all tenants; every query filters by organization_id.
# Changing EMBEDDING_DIMENSIONS needs a new collection name (or drop it) and a reindex.
QDRANT_COLLECTION=atlas_chunks

# ---------- Uploads and storage ----------
# Maximum upload size in bytes (default 20 MB)
MAX_UPLOAD_BYTES=20971520
# local: files on disk (dev/test) | supabase: Supabase Storage (needs SUPABASE_URL
# and SUPABASE_SERVICE_ROLE_KEY, used server-side only after authorization)
STORAGE_BACKEND=local
# Directory for local storage (compose overrides it to a volume)
LOCAL_STORAGE_PATH=./.storage
# HMAC key for local signed download URLs. Local value only; never commit a real one.
STORAGE_SIGNING_SECRET=local-dev-only-storage-signing-secret
# Base URL used in local signed download links
PUBLIC_BASE_URL=http://localhost:8000
# Lifetime of signed download URLs in seconds (10-300)
SIGNED_URL_TTL_SECONDS=120
# Supabase Storage bucket for originals (private bucket)
SUPABASE_STORAGE_BUCKET=documents

# ---------- Chunking and embeddings ----------
# tiktoken: cl100k_base, the encoding of text-embedding-3-small (baked into the image).
# simple: offline approximation for environments that cannot download the encoding.
TOKENIZER=tiktoken
# Chunk size and overlap in tokens (blueprint: 512 / 64)
CHUNK_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
# openai: real embeddings (needs OPENAI_API_KEY) | hash: deterministic offline
# embeddings for local dev and tests, with no semantic quality.
EMBEDDING_PROVIDER=hash
# Vector size; 1536 matches text-embedding-3-small, so switching providers later
# only needs a reindex, not a new collection.
EMBEDDING_DIMENSIONS=1536

# ---------- Retrieval and answering ----------
# Candidates per search list, fused list size and RRF constant
RETRIEVAL_DENSE_K=20
RETRIEVAL_SPARSE_K=20
RETRIEVAL_FUSED_K=20
RRF_K=60
# Authorized chunks passed to the model as evidence
ANSWER_MAX_CHUNKS=8
# Earlier messages of the conversation included in the prompt
CHAT_HISTORY_MESSAGES=6
# openai: real answers (needs OPENAI_API_KEY) | extractive: offline generator that
# quotes matching source sentences, for local dev and tests only.
LLM_PROVIDER=extractive
# Chat model (blueprint leaves the exact model open)
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60
# Optional USD prices per 1M tokens for usage cost estimates. Leave empty to
# record tokens only; costs are never guessed.
LLM_INPUT_PRICE_PER_1M=
LLM_OUTPUT_PRICE_PER_1M=

# ---------- Agent limits ----------
# Hard cap on graph steps per question (LangGraph recursion limit is set above it)
AGENT_MAX_STEPS=24
# Query rewrites after weak evidence before abstaining
AGENT_MAX_REWRITES=2
# Regenerations after a failed citation check before keeping only supported
# sentences or abstaining
AGENT_MAX_CORRECTIONS=1
# Wall-clock limit for one question, in seconds
AGENT_TIMEOUT_SECONDS=45
# Approximate token budget for evidence sent to the model
AGENT_MAX_EVIDENCE_TOKENS=6000
# Share of the question's topic terms the evidence must cover to count as
# sufficient (heuristic floor; with LLM_PROVIDER=openai the model also judges)
AGENT_SUFFICIENT_COVERAGE=0.6

# ---------- Job queue ----------
# Attempts before a job fails permanently
JOB_MAX_ATTEMPTS=5
# Exponential backoff: base * 2^(attempt-1), capped, with jitter (seconds)
JOB_BACKOFF_BASE_SECONDS=5
JOB_BACKOFF_MAX_SECONDS=300
# A running job whose worker vanished is reclaimed after this many seconds
JOB_LEASE_SECONDS=600

# ---------- Health / worker ----------
# Seconds each /ready dependency check may take before it counts as failed
READY_CHECK_TIMEOUT_SECONDS=2
# Seconds the worker waits between queue polls
WORKER_POLL_INTERVAL_SECONDS=5

# ---------- Supabase Auth ----------
# Every request's JWT is verified for signature, issuer, audience and expiry.
# Expected JWT issuer: ${SUPABASE_URL}/auth/v1 (hosted) or http://localhost:54321/auth/v1 (CLI)
SUPABASE_JWT_ISSUER=http://localhost:54321/auth/v1
# Expected JWT audience (Supabase default: authenticated)
SUPABASE_JWT_AUDIENCE=authenticated
# JWKS endpoint for asymmetric signing keys (newer Supabase projects):
# https://<ref>.supabase.co/auth/v1/.well-known/jwks.json. Takes precedence over the secret.
SUPABASE_JWKS_URL=
# Legacy HS256 signing secret. The value below is for local dev only; with it,
# `python -m app.db.manage dev-token alice@acme.example` mints test tokens.
# Real secrets: never commit.
SUPABASE_JWT_SECRET=local-dev-only-jwt-secret-at-least-32-characters
# Hours an organization invitation stays valid
INVITATION_TTL_HOURS=72

# ---------- Web app and local Supabase Auth ----------
# Browser origins allowed to call the API cross-origin, comma-separated (e.g. the
# Vercel frontend https://atlas-ai.vercel.app). Empty = same-origin only.
CORS_ALLOWED_ORIGINS=
# Host port of the web app (React + nginx proxy for /v1 and /auth/v1)
WEB_PORT=8080
# Host port of the local Supabase Auth (GoTrue) container
AUTH_PORT=9999
# Local only: confirm new accounts without email. Never true in production.
AUTH_AUTOCONFIRM=true

# ---------- Supabase project ----------
# Project URL, e.g. https://<ref>.supabase.co (used by STORAGE_BACKEND=supabase)
SUPABASE_URL=
# Public anon key for the browser. The value below is a local-only token signed
# with the local SUPABASE_JWT_SECRET; use your project's anon key elsewhere.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6Imh0dHA6Ly9sb2NhbGhvc3Q6NTQzMjEvYXV0aC92MSIsImlhdCI6MTc2NDAyODgwMCwiZXhwIjoyMDc5Mzg4ODAwfQ.S2mj0ROOxGQ6Ah9ty8gt0feXp5xYpCdTjqELCz8FgrM
# Service role key. Used only for Supabase Storage calls made by the server after
# authorization; never for database sessions. Secret: never commit.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- OpenAI ----------
# API key for embeddings (EMBEDDING_PROVIDER=openai) and answers (LLM_PROVIDER=openai). Secret.
OPENAI_API_KEY=
# Dense embedding model
EMBEDDING_MODEL=text-embedding-3-small
# API base URL (change only for a compatible proxy)
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- Observability (not used yet: Week 6) ----------
# OTLP collector endpoint for OpenTelemetry traces
OTEL_EXPORTER_OTLP_ENDPOINT=
